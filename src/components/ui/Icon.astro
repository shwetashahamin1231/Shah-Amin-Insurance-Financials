---
/**
 * Inline SVG icon. Decorative by default (hidden from screen readers);
 * pass `label` when the icon is the only content of a control.
 *   <Icon name="phone" />            decorative
 *   <Icon name="x" label="Close" />  meaningful
 */
import { ICONS, type IconName } from '../../lib/icons';

interface Props {
  name: IconName;
  size?: number | string;
  label?: string;
  class?: string;
}

const { name, size = '1.25em', label, class: className } = Astro.props;
const raw = ICONS[name];
// Strip the root <svg> wrapper and keep only the drawing.
const inner = raw.replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
const dim = typeof size === 'number' ? `${size}px` : size;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 256 256"
  width={dim}
  height={dim}
  fill="currentColor"
  class:list={['icon', className]}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={inner}
/>

<style>
  .icon {
    flex: none;
    display: inline-block;
    vertical-align: -0.18em;
  }
</style>
