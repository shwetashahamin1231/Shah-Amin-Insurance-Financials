---
/**
 * Small round advisor photo (head and shoulders) for cards and call buttons.
 * Uses src/assets/team/<advisor id>-avatar.jpg when it exists; otherwise the
 * advisor's initials on green, as before.
 *
 *   <AdvisorAvatar advisor={ADVISORS.gautam} size={52} />
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import type { Advisor } from '../../config/site';

interface Props {
  advisor: Advisor;
  /** Diameter in CSS pixels. */
  size?: number;
  class?: string;
}
const { advisor, size = 52, class: className } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/team/*-avatar.jpg', { eager: true });
const photo = Object.entries(files).find(([path]) => path.endsWith(`/${advisor.id}-avatar.jpg`))?.[1].default;
---

<span class:list={['avatar', className]} style={`--avatar:${size}px`} aria-hidden="true">
  {
    photo ? (
      <Picture src={photo} alt="" widths={[size, size * 2, size * 3].map((w) => Math.min(w, photo.width))} sizes={`${size}px`} formats={['avif', 'webp']} fallbackFormat="jpg" class="avatar__img" />
    ) : (
      <span class="avatar__initials">{advisor.initials}</span>
    )
  }
</span>

<style>
  .avatar {
    display: grid;
    place-items: center;
    flex: none;
    inline-size: var(--avatar);
    block-size: var(--avatar);
    border-radius: 50%;
    overflow: hidden;
    background: var(--green-800);
    box-shadow:
      0 0 0 1px var(--gold-600),
      0 0 0 4px rgb(175 130 67 / 0.18);
  }
  .avatar :global(picture),
  .avatar :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }
  .avatar__initials {
    font-family: var(--ff-display);
    font-size: calc(var(--avatar) * 0.42);
    font-weight: 600;
    line-height: 1;
    color: var(--gold-300);
  }
</style>
