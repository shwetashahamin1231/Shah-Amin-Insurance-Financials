---
/**
 * Brand lockup: the real logo medallion + "Shah & Amin / Financial Services"
 * wordmark set in the site's typefaces. `compact` drops the wordmark.
 */
import { Picture } from 'astro:assets';
import medallion from '../../assets/brand/logo-medallion.png';
import { url } from '../../lib/url';

interface Props {
  size?: number;
  compact?: boolean;
  href?: string | null;
  class?: string;
  /** Load eagerly (header) or lazily (footer). */
  eager?: boolean;
}

const { size = 56, compact = false, href = '/', class: className, eager = false } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag
  href={href ? url(href) : undefined}
  class:list={['logo', { 'logo--compact': compact }, className]}
  aria-label={href ? 'Shah & Amin Financial Services — home' : undefined}
  style={`--logo-size:${size}px`}
>
  <Picture
    src={medallion}
    alt={href ? '' : 'Shah & Amin Financial Services logo'}
    widths={[size, size * 2, size * 3]}
    sizes={`${size}px`}
    formats={['avif', 'webp']}
    width={size}
    height={size}
    loading={eager ? 'eager' : 'lazy'}
    class="logo__mark"
  />
  {
    !compact && (
      <span class="logo__words" aria-hidden={href ? 'true' : undefined}>
        <span class="logo__name">Shah &amp; Amin</span>
        <span class="logo__tag">Financial Services</span>
      </span>
    )
  }
</Tag>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    color: var(--heading);
    text-decoration: none;
    min-block-size: 44px;
  }
  .logo :global(.logo__mark) {
    inline-size: var(--logo-size);
    block-size: var(--logo-size);
    border-radius: 50%;
    box-shadow: 0 0 0 1px rgb(175 130 67 / 0.55), 0 6px 18px -6px rgb(6 18 6 / 0.6);
  }
  .logo :global(picture) {
    flex: none;
    display: block;
  }
  .logo__words {
    display: grid;
    line-height: 1;
  }
  .logo__name {
    font-family: var(--ff-display);
    font-weight: 600;
    font-size: calc(var(--logo-size) * 0.46);
    letter-spacing: 0.01em;
    white-space: nowrap;
  }
  .logo__tag {
    margin-block-start: 0.38em;
    font-family: var(--ff-body);
    font-size: max(0.6875rem, calc(var(--logo-size) * 0.19));
    font-weight: 500;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--accent);
    white-space: nowrap;
  }
</style>
