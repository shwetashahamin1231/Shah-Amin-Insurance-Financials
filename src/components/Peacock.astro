---
/**
 * Peacock mascot — a hand-drawn, layered inline SVG (≈12 KB) that sits in the
 * bottom-right corner (a small "peek" from the bottom-left on phones, where the
 * Call button owns the right). Rendered once per page by BaseLayout; brought to
 * life by src/scripts/peacock/ (lazy-loaded when the browser is idle).
 *
 * The art is server-rendered in its friendly rest pose, so it looks right before
 * (and without) JavaScript. Animatable parts carry `pk-*` classes; pivots live in
 * `data-origin` (SVG user units, viewBox 0 0 200 250):
 *   .pk-bird (hop)  .pk-shadow  .pk-tail > .pk-feather ×9 (pivot = tail base)
 *   .pk-legs  .pk-torso (breathing)  .pk-mound (back scallops)  .pk-breast
 *   .pk-head (neck + head, pivot = neck base) > .pk-crest > .pk-plume ×5
 *   .pk-face > .pk-eye ×2 (sclera · .pk-iris [iris, pupil, glints] · .pk-lid · lid line + lashes)
 *   .pk-beak (.pk-beak-u / .pk-beak-l)  .pk-wing (pivot = shoulder)  .pk-hit (pointer area)
 * Ids use the `pk_` prefix and are rewritten per preview instance so they stay unique.
 *
 *   <Peacock />                               the live mascot (once per page)
 *   <Peacock preview="phone" uid="p1" />      static rendering for the QA page
 */
interface Props {
  /** Static, non-interactive rendering for src/pages/dev/peacock.astro. */
  preview?: 'desktop' | 'tablet' | 'phone';
  /** Unique id suffix when several previews share a page (letters/digits). */
  uid?: string;
}

