// One line, no indentation (≈12 KB). Preview copies get their own id prefix.
const art = (preview ? ART.replaceAll('pk_', `pk${uid ?? preview}_`) : ART).replace(/\n\s*/g, '');
const svgAttrs = {
  viewBox: '0 0 200 250',
  'aria-hidden': 'true',
  focusable: 'false',
  'stroke-linejoin': 'round',
  'stroke-linecap': 'round',
} as const;
---

{
  preview ? (
    <div class:list={['peacock-preview', `peacock-preview--${preview}`]}>
      <svg class="peacock__svg" {...svgAttrs} set:html={art} />
    </div>
  ) : (
    <div id="peacock-root" class="peacock" data-peacock-root data-peacock data-intro-inert>
      <div class="peacock__lift">
        <button type="button" class="peacock__btn" aria-label="Peacock mascot — press to see it fan its tail">
          <svg class="peacock__svg" {...svgAttrs} set:html={art} />
        </button>
      </div>
    </div>
  )
}

{
  !preview && (
    <script is:inline>
      // Restore the last gaze before the first paint, so the eyes don't snap between pages
      // (the controller keeps tracking from here once it loads).
      (function () {
        var d = document;
        var run = function () {
          try {
            var g = JSON.parse(sessionStorage.getItem('sa-peacock-gaze') || 'null');
            if (!g || d.documentElement.classList.contains('reduce-motion')) return;
            if (!matchMedia('(hover: hover) and (pointer: fine) and (min-width: 48rem)').matches) return;
            d.querySelectorAll('[data-peacock] .pk-iris').forEach(function (el) {
              var m = (el.getAttribute('data-max') || '0 0').split(' ');
              el.setAttribute('transform', 'translate(' + (g.gx * m[0]).toFixed(2) + ' ' + (g.gy * m[1]).toFixed(2) + ')');
            });
          } catch (e) {}
        };
        if (d.prerendering) d.addEventListener('prerenderingchange', run, { once: true });
        else run();
      })();
    </script>
  )
}

<style>
  /* ── Live mascot ─────────────────────────────────────────────────────────
     Sizes: desktop 140px (150 on very wide screens) · tablets 96px, perched
     above the Call button · phones: a 64px peek from the bottom-left corner.
     States (set by the controller): .is-tucked while scrolling, .is-ducked when
     it would cover focused content or the very end of the page, .is-popped when
     a phone visitor taps the peek. Only the bird's own outline takes the pointer. */
  .peacock {
    --pk-h: 140px;
    --pk-tuck: calc(var(--pk-h) * 0.55);
    --pk-duck: calc(var(--pk-h) + 2.5rem);
    --pk-pop: 0px;
    position: fixed;
    inset-block-end: max(1.25rem, env(safe-area-inset-bottom));
    inset-inline-end: max(1.5rem, env(safe-area-inset-right));
    z-index: var(--z-peacock);
    inline-size: calc(var(--pk-h) * 0.8);
    block-size: var(--pk-h);
    pointer-events: none;
    view-transition-name: peacock;
  }
  @media (min-width: 100rem) {
    .peacock {
      --pk-h: 150px;
    }
  }
  /* Tablets: smaller, perched above the floating Call button (56px + 16px margin). */
  @media (max-width: 63.99rem) {
    .peacock {
      --pk-h: 96px;
      inset-inline-end: max(1rem, env(safe-area-inset-right));
      inset-block-end: calc(max(1rem, env(safe-area-inset-bottom)) + 56px + 0.75rem);
    }
  }
  /* Phones: head and crest peek over the bottom edge, bottom-left; mirrored to face the page. */
  @media (max-width: 47.99rem) {
    .peacock {
      --pk-h: 120px;
      --pk-peek: calc(64px + env(safe-area-inset-bottom, 0px));
      --pk-tuck: calc(var(--pk-peek) * 0.55);
      --pk-duck: calc(var(--pk-peek) + 1.5rem);
      --pk-pop: calc((var(--pk-peek) - var(--pk-h)) * 0.9);
      inset-inline: max(0px, env(safe-area-inset-left)) auto;
      inset-block-end: calc(var(--pk-peek) - var(--pk-h));
    }
    .peacock__svg {
      transform: scaleX(-1);
    }
  }

  .peacock__lift {
    block-size: 100%;
    transform: translate3d(0, var(--pk-shift, 0px), 0);
    transition:
      transform var(--pk-dur, 640ms) var(--pk-ease, cubic-bezier(0.34, 1.36, 0.64, 1)),
      opacity 260ms var(--ease-out),
      visibility 0s linear 0s;
    will-change: transform;
  }
  .peacock.is-tucked {
    --pk-shift: var(--pk-tuck);
    --pk-dur: 380ms;
    --pk-ease: var(--ease-out);
  }
  .peacock.is-popped {
    --pk-shift: var(--pk-pop);
    --pk-dur: 520ms;
  }
  .peacock.is-ducked {
    --pk-shift: var(--pk-duck);
    --pk-dur: 380ms;
    --pk-ease: var(--ease-out);
  }
  /* Hidden by the footer switch, or while a dialog is open. */
  :global(html.peacock-hidden) .peacock__lift,
  :global(html.scroll-locked) .peacock__lift {
    transform: translate3d(0, var(--pk-duck), 0);
    opacity: 0;
    visibility: hidden;
    transition:
      transform 380ms var(--ease-out),
      opacity 260ms var(--ease-out),
      visibility 0s linear 380ms;
  }
  /* Reduced motion: no sliding — it simply fades out of the way. */
  :global(html.reduce-motion) .peacock .peacock__lift {
    transform: none;
    transition:
      opacity 240ms linear,
