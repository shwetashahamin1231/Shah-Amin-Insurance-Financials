---
/** A single client review with star rating (rating announced as text for screen readers). */
import Icon from '../ui/Icon.astro';
import type { Review } from '../../data/reviews';

interface Props {
  review: Review;
}
const { review } = Astro.props;
const date = review.date
  ? new Intl.DateTimeFormat('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${review.date}T12:00:00Z`))
  : null;
---

<figure class="review">
  <div class="review__stars" role="img" aria-label={`Rated ${review.rating} out of 5`}>
    {
      Array.from({ length: 5 }, (_, i) => (
        <svg viewBox="0 0 24 24" class:list={['review__star', { 'is-on': i < review.rating }]} aria-hidden="true">
          <path d="M12 2.6l2.83 6.07 6.67.77-4.94 4.53 1.33 6.57L12 17.27l-5.89 3.27 1.33-6.57L2.5 9.44l6.67-.77z" />
        </svg>
      ))
    }
  </div>
  <blockquote class="review__text">
    <Icon name="quotes" class="review__mark" />
    <p>{review.text}</p>
  </blockquote>
  <figcaption class="review__by">
    <span class="review__name">{review.name}</span>
    <span class="review__meta">{[review.topic, review.source, date].filter(Boolean).join(' · ')}</span>
  </figcaption>
</figure>

<style>
  .review {
    display: grid;
    align-content: start;
    gap: var(--space-m);
    margin: 0;
    padding: var(--space-l);
    background: var(--bg-raised);
    border: 1px solid var(--rule);
    box-shadow: var(--shadow-s);
  }
  .review__stars {
    display: flex;
    gap: 0.2rem;
  }
  .review__star {
    inline-size: 1.25rem;
    block-size: 1.25rem;
    fill: transparent;
    stroke: var(--accent);
    stroke-width: 1.2;
  }
  .review__star.is-on {
    fill: var(--gold-500);
    stroke: var(--gold-600);
  }
  .review__text {
    position: relative;
    margin: 0;
    font-family: var(--ff-display);
    font-size: 1.5rem;
    line-height: 1.4;
    color: var(--heading);
  }
  .review__text :global(.review__mark) {
    font-size: 2rem;
    color: var(--accent);
    margin-block-end: 0.25rem;
    display: block;
  }
  .review__by {
    display: grid;
    gap: 0.15rem;
    padding-block-start: var(--space-s);
    border-block-start: 1px solid var(--rule);
  }
  .review__name {
    font-weight: 600;
  }
  .review__meta {
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
</style>
