---
/**
 * Segmented choice — a row of large tiles that behave as radio buttons
 * (arrow keys move between them, like any radio group).
 *   <RadioGroup id="book-meeting" name="meetingType" legend="How would you like to meet?"
 *     options={[{ value: 'In person', icon: 'map-pin' }, { value: 'Phone', icon: 'phone' }]} required />
 * The chosen tile fills with colour AND shows a check mark (never colour alone).
 */
import Field from './Field.astro';
import Icon from '../ui/Icon.astro';
import type { IconName } from '../../lib/icons';

export interface RadioOption {
  value: string;
  label?: string;
  /** Small second line under the label. */
  description?: string;
  icon?: IconName;
}

interface Props {
  id: string;
  name: string;
  legend: string;
  options: RadioOption[];
  /** Preselected value. */
  value?: string;
  hint?: string;
  required?: boolean;
  requiredMessage?: string;
  /** Columns on wide screens (tiles wrap to fewer columns on small screens). */
  columns?: number;
  class?: string;
}

const { id, name, legend, options, value, hint, required = false, requiredMessage, columns = options.length, class: className } = Astro.props;
---

<Field
  as="fieldset"
  role="radiogroup"
  id={id}
  label={legend}
  hint={hint}
  validate="choice"
  required={required}
  requiredMessage={requiredMessage}
  optional={!required}
  class={className}
>
  <div class="segmented" style={`--cols:${columns}`}>
    {
      options.map((o, i) => (
        <label class="segment">
          <input class="segment__input" type="radio" id={`${id}-${i}`} name={name} value={o.value} checked={value === o.value} required={required} />
          <span class="segment__box">
            {o.icon && <Icon name={o.icon} class="segment__icon" />}
            <span class="segment__text">
              <span class="segment__label">{o.label ?? o.value}</span>
              {o.description && <span class="segment__desc">{o.description}</span>}
            </span>
            <Icon name="check" class="segment__check" />
          </span>
        </label>
      ))
    }
  </div>
</Field>

<style>
  .segmented {
    /* Selected tile colours: gold on green surfaces, logo green on paper/ivory. */
    --sel-bg: var(--gold-400);
    --sel-fg: var(--green-900);
    --sel-ring: rgb(255 247 225 / 0.45);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9.5rem), 1fr));
    gap: 0.6rem;
  }
  @media (min-width: 48rem) {
    .segmented {
      grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr));
    }
  }
  :global(:is(.surface-paper, .surface-ivory)) .segmented {
    --sel-bg: var(--green-800);
    --sel-fg: var(--ivory-50);
    --sel-ring: var(--gold-600);
  }

  .segment {
    position: relative;
    display: block;
    cursor: pointer;
  }
  /* The real radio button covers the tile invisibly, so clicks, taps and keys all work natively. */
  .segment__input {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .segment__box {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    block-size: 100%;
    min-block-size: 3.5rem;
    padding: 0.7rem 0.95rem;
    color: var(--text);
    background-color: var(--field-bg);
    border: 1px solid var(--field-border);
    border-block-end-color: var(--rule-strong);
    border-radius: var(--radius-s);
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.25;
    transition:
      background-color var(--dur-hover) var(--ease-out),
      border-color var(--dur-hover) var(--ease-out),
      color var(--dur-hover) var(--ease-out);
  }
  .segment:hover .segment__box {
    border-color: var(--rule-strong);
  }
  .segment__text {
    display: grid;
    gap: 0.1rem;
    flex: 1;
  }
  .segment__desc {
    font-size: 0.9375rem;
    font-weight: 400;
    color: var(--text-muted);
  }
  .segment__box :global(.segment__icon) {
    font-size: 1.35rem;
    color: var(--accent);
  }
  .segment__box :global(.segment__check) {
    font-size: 1.15rem;
    opacity: 0;
    transform: scale(calc(1 - 0.4 * var(--motion)));
    transition:
      opacity var(--dur-hover) var(--ease-out),
      transform var(--dur-ui) var(--ease-silk);
  }

  .segment__input:focus-visible + .segment__box {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }
  .segment__input:checked + .segment__box {
    color: var(--sel-fg);
    background-color: var(--sel-bg);
    border-color: var(--sel-bg);
    box-shadow: inset 0 0 0 1px var(--sel-ring);
  }
  .segment__input:checked + .segment__box :global(.segment__icon),
  .segment__input:checked + .segment__box .segment__desc {
    color: inherit;
  }
  .segment__input:checked + .segment__box :global(.segment__check) {
    opacity: 1;
    transform: none;
  }

  :global(.is-invalid) .segment__box {
    border-color: var(--error);
  }

  @media (forced-colors: active) {
    .segment__input:checked + .segment__box {
      outline: 3px solid Highlight;
    }
  }
</style>
