---
/**
 * Result panels shown after pressing Send. Focus moves to the heading.
 *
 *   <FormStatus type="success" id="rsvp-done" title="You’re on the list">
 *     …your own confirmation content…
 *   </FormStatus>
 *
 *   <FormStatus type="error" id="rsvp-problem" />
 *     → "We couldn’t send that" + the reason (filled in by the form engine),
 *       a "Try again" button (when retrying can help) and both phone numbers.
 */
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
import { ADVISOR_LIST } from '../../config/site';

interface Props {
  type: 'success' | 'error';
  id: string;
  title?: string;
  headingLevel?: 2 | 3 | 4;
  class?: string;
}

const { type, id, title = type === 'success' ? 'Thank you' : 'We couldn’t send that', headingLevel = 3, class: className } = Astro.props;
const H = `h${headingLevel}` as 'h2' | 'h3' | 'h4';
---

{
  type === 'success' ? (
    <div class:list={['form-status', 'form-status--success', className]} id={id} data-form-success hidden>
      <span class="form-status__seal" aria-hidden="true">
        <Icon name="check" />
      </span>
      <div class="form-status__body">
        <H class="form-status__title" tabindex="-1" data-status-heading>
          {title}
        </H>
        <slot />
      </div>
    </div>
  ) : (
    <div class:list={['form-status', 'form-status--error', className]} id={id} data-form-error hidden>
      <span class="form-status__seal" aria-hidden="true">
        <Icon name="warning-circle" />
      </span>
      <div class="form-status__body">
        <H class="form-status__title" tabindex="-1" data-status-heading>
          {title}
        </H>
        <p class="form-status__message" data-error-message />
        <div class="form-status__actions">
          <span data-retry-wrap>
            <Button variant="outline" size="s" icon="arrows-clockwise" iconPosition="start" data-retry>
              Try again
            </Button>
          </span>
          <ul class="form-status__phones" role="list">
            {ADVISOR_LIST.map((a) => (
              <li>
                <a href={`tel:${a.phoneHref}`} class="form-status__phone">
                  <Icon name="phone" />
                  <span>
                    Call {a.firstName} <span class="num">{a.phone}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  )
}

<style>
  .form-status {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem 1.25rem;
    padding: clamp(1.25rem, 0.9rem + 1.5vw, 2rem);
    background-color: var(--bg-raised);
    border: 1px solid var(--rule-strong);
    box-shadow: var(--shadow-s);
  }
  /* Certificate-style inner hairline. */
  .form-status::before {
    content: '';
    position: absolute;
    inset: 5px;
    border: 1px solid var(--rule);
    pointer-events: none;
  }
  .form-status--error {
    border-color: var(--error);
  }
  .form-status--error::before {
    border-color: color-mix(in srgb, var(--error) 35%, transparent);
  }

  .form-status__seal {
    display: grid;
    place-items: center;
    inline-size: 3.25rem;
    block-size: 3.25rem;
    border-radius: 50%;
    font-size: 1.6rem;
    color: var(--accent);
    box-shadow:
      inset 0 0 0 1px var(--rule-strong),
      inset 0 0 0 4px var(--bg-raised),
      inset 0 0 0 5px var(--rule);
  }
  .form-status--error .form-status__seal {
    color: var(--error);
    box-shadow: inset 0 0 0 1px var(--error);
  }

  .form-status__body {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }
  .form-status__body > :global(*) {
    margin: 0;
  }
  .form-status__title {
    font-size: clamp(1.625rem, 1.4rem + 0.8vw, 2rem);
    font-weight: 600;
    line-height: 1.15;
    color: var(--heading);
  }
  .form-status__title:focus {
    outline: none;
  }
  .form-status__title:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 4px;
  }
  .form-status__message {
    max-width: 60ch;
  }
  .form-status__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    padding-block-start: 0.25rem;
  }
  .form-status__phones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }
  .form-status__phone {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-block-size: 44px;
    font-weight: 500;
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--rule-strong);
    text-underline-offset: 0.22em;
  }
  .form-status__phone :global(.icon) {
    color: var(--accent);
  }
  .form-status__phone:hover {
    color: var(--accent);
  }
  @media (max-width: 30rem) {
    .form-status {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
