---
/**
 * Late-enrollment penalty estimator for Part B and Part D.
 *  • Part B: 10% of the standard premium for each FULL 12 months without Part B.
 *  • Part D: 1% of the national base beneficiary premium × months without
 *    creditable drug coverage, rounded to the nearest $0.10.
 * The page is printed with Medicare.gov's own examples (24 months / 14 months);
 * src/scripts/medicare/penalty.ts recalculates as the visitor types.
 * Figures: FIGURES in src/data/medicare.ts. Formulas: src/scripts/medicare/logic.ts.
 */
import { FIGURES, SOURCES } from '../../data/medicare';
import { money, partBPenalty, partDPenalty } from '../../scripts/medicare/logic';

const premium = FIGURES.partB.premium;
const premiumYear = FIGURES.partB.year;
const base = FIGURES.partD.basePremium;
const baseYear = FIGURES.partD.year;
const b = partBPenalty(24, premium);
const d = partDPenalty(14, base);
---

<div class="penalty" data-penalty data-b-premium={premium} data-d-base={base} data-year={premiumYear}>
  <!-- Part B -->
  <form class="penalty__card" data-penalty-form="b">
    <h3 class="penalty__title">Part B <em>late penalty</em></h3>
    <p class="penalty__rule">10% of the standard premium for each full 12 months you could have had Part B but didn’t sign up.</p>
    <div class="penalty__field">
      <label class="penalty__label" for="penalty-b-months">Months without Part B</label>
      <p class="penalty__hint" id="penalty-b-hint">After your Initial Enrollment Period ended — don’t count months you had coverage from a current job.</p>
      <div class="stepper">
        <button type="button" class="stepper__btn" data-step="-1" aria-label="One month fewer" aria-controls="penalty-b-months">−</button>
        <input
          class="stepper__input num"
          id="penalty-b-months"
          name="months"
          type="number"
          inputmode="numeric"
          min="0"
          max="480"
          step="1"
          value="24"
          aria-describedby="penalty-b-hint"
          data-penalty-input
        />
        <button type="button" class="stepper__btn" data-step="1" aria-label="One month more" aria-controls="penalty-b-months">+</button>
      </div>
    </div>
    <output class="penalty__result" for="penalty-b-months" aria-live="off" data-penalty-output>
      <span class="penalty__big num" data-out="added">+{money(b.added)}</span>
      <span class="penalty__per">a month added to your Part B premium</span>
      <span class="penalty__line" data-out="detail">
        {b.periods} full {b.periods === 1 ? 'year' : 'years'} × 10% = {b.percent}% of {money(premium)} · your {premiumYear} premium would be about {money(b.total)} a month
      </span>
    </output>
  </form>

  <!-- Part D -->
  <form class="penalty__card" data-penalty-form="d">
    <h3 class="penalty__title">Part D <em>late penalty</em></h3>
    <p class="penalty__rule">1% of the national base premium ({money(base)} in {baseYear}) for each full month without creditable drug coverage, rounded to the nearest 10¢.</p>
    <div class="penalty__field">
      <label class="penalty__label" for="penalty-d-months">Months without drug coverage</label>
      <p class="penalty__hint" id="penalty-d-hint">Full months after your Initial Enrollment Period with no Part D or other creditable drug coverage (gaps of 63 days or more count).</p>
      <div class="stepper">
        <button type="button" class="stepper__btn" data-step="-1" aria-label="One month fewer" aria-controls="penalty-d-months">−</button>
        <input
          class="stepper__input num"
          id="penalty-d-months"
          name="months"
          type="number"
          inputmode="numeric"
          min="0"
          max="480"
          step="1"
          value="14"
          aria-describedby="penalty-d-hint"
          data-penalty-input
        />
        <button type="button" class="stepper__btn" data-step="1" aria-label="One month more" aria-controls="penalty-d-months">+</button>
      </div>
    </div>
    <output class="penalty__result" for="penalty-d-months" aria-live="off" data-penalty-output>
      <span class="penalty__big num" data-out="added">+{money(d.monthly)}</span>
      <span class="penalty__per">a month added to your drug plan premium</span>
      <span class="penalty__line" data-out="detail">
        {d.months} months × 1% × {money(base)} = {money(d.raw)}, rounded to {money(d.monthly)}
      </span>
    </output>
  </form>

  <p class="visually-hidden" aria-live="polite" data-penalty-announce></p>

  <div class="penalty__notes">
    <p>
      <strong>An estimate, not a bill.</strong> Penalties are usually charged for as long as you have that coverage. The Part D amount is recalculated each year
      from the new base premium. People who qualify for a Special Enrollment Period, a Medicare Savings Program or Extra Help may not owe a penalty.
    </p>
    <p class="penalty__source">
      Source:{' '}
      <a class="text-link" href={SOURCES.penalties.url} target="_blank" rel="noopener">
        {SOURCES.penalties.label}<span class="visually-hidden"> (opens in a new tab)</span>
      </a>
    </p>
  </div>
</div>

<script>
  import '../../scripts/medicare/penalty';
</script>

<style>
  .penalty {
    display: grid;
    gap: var(--space-m);
  }
  @media (min-width: 64rem) {
    .penalty {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .penalty__notes {
      grid-column: 1 / -1;
    }
  }
  .penalty__card {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-m);
    padding: clamp(1.5rem, 1.25rem + 1.2vw, 2.5rem);
    background: var(--bg-raised);
    border: 1px solid var(--rule-strong);
    box-shadow: var(--shadow-m);
  }
  .penalty__card::before {
    content: '';
    position: absolute;
    inset: 6px;
    border: 1px solid var(--rule);
    pointer-events: none;
  }
  .penalty__title {
    font-size: var(--fs-h3);
  }
  .penalty__rule {
    color: var(--text-muted);
  }
  .penalty__field {
    position: relative;
    display: grid;
    gap: var(--space-2xs);
  }
  .penalty__label {
    font-weight: 600;
  }
  .penalty__hint {
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  /* − [ 24 ] + */
  .stepper {
    display: inline-grid;
    grid-template-columns: 3.25rem 7rem 3.25rem;
    justify-self: start;
    margin-block-start: var(--space-2xs);
    border: 1px solid var(--field-border);
    border-radius: var(--radius-s);
    background: var(--field-bg);
  }
  .stepper__btn {
    display: grid;
    place-items: center;
    min-block-size: 3.25rem;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--accent);
    transition: background-color var(--dur-hover) var(--ease-out);
  }
  .stepper__btn:hover {
    background: rgb(175 130 67 / 0.14);
  }
  .stepper__input {
    inline-size: 100%;
    min-block-size: 3.25rem;
    border: 0;
    border-inline: 1px solid var(--field-border);
    background: transparent;
    text-align: center;
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--text);
    appearance: textfield;
    -moz-appearance: textfield;
  }
  .stepper__input::-webkit-outer-spin-button,
  .stepper__input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .penalty__result {
    position: relative;
    display: grid;
    gap: 0.2rem;
    padding-block-start: var(--space-m);
    border-block-start: 1px solid var(--rule);
  }
  .penalty__big {
    font-family: var(--ff-display);
    font-size: clamp(2.5rem, 2rem + 1.8vw, 3.5rem);
    font-weight: 500;
    line-height: 1.05;
    color: var(--heading);
  }
  .penalty__per {
    font-weight: 500;
    color: var(--accent);
  }
  .penalty__line {
    margin-block-start: var(--space-2xs);
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
  .penalty__notes {
    display: grid;
    gap: var(--space-xs);
    max-width: 60rem;
    color: var(--text-muted);
  }
  .penalty__notes strong {
    color: var(--text);
  }
  .penalty__source {
    font-size: var(--fs-small);
  }
</style>
