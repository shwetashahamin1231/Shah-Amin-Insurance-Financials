---
/**
 * The headline Medicare amounts as engraved figure tiles — each labelled with
 * the year it applies to — plus the income note, a notice while next year's
 * Part A/B amounts are unpublished, and the official sources.
 * All numbers: FIGURES / AWAITING in src/data/medicare.ts.
 */
import { AWAITING, FIGURES, SOURCES } from '../../data/medicare';
import { money } from '../../scripts/medicare/logic';

const { partA: A, partB: B, partD: D } = FIGURES;
const whole = (n: number) => money(n, !Number.isInteger(n));

const tiles = [
  { year: D.year, label: 'Part D deductible', value: whole(D.maxDeductible), unit: 'per year, at most' },
  { year: D.year, label: 'Part D out-of-pocket cap', value: whole(D.outOfPocketCap), unit: 'per year for covered drugs' },
  { year: B.year, label: 'Part B standard premium', value: whole(B.premium), unit: 'per month' },
  { year: B.year, label: 'Part B deductible', value: whole(B.deductible), unit: 'per year' },
  { year: A.year, label: 'Part A hospital deductible', value: whole(A.deductible), unit: 'per benefit period' },
  { year: A.year, label: 'Part A premium', value: whole(A.premiumMostPeople), unit: `for most people (otherwise ${whole(A.premiumReduced)} or ${whole(A.premiumFull)} a month)` },
];
const sources = [SOURCES.partD2027, SOURCES.partDBase2027, SOURCES.cmsFactSheet, SOURCES.medicareCosts];
---

<div class="costs">
  <ul class="costs__grid" role="list">
    {
      tiles.map((t) => (
        <li class="tile" data-reveal>
          <span class="tile__year">{t.year}</span>
          <span class="tile__label">{t.label}</span>
          <span class="tile__value num">{t.value}</span>
          <span class="tile__unit">{t.unit}</span>
        </li>
      ))
    }
  </ul>

  <div class="costs__notes">
    {
      AWAITING && (
        <p>
          <strong>{AWAITING.year} {AWAITING.what}:</strong> not yet announced. The Centers for Medicare &amp; Medicaid Services usually publishes them in{' '}
          {AWAITING.expected}. Until then, the {B.year} amounts are shown and labelled {B.year}.
        </p>
      )
    }
    <p>
      <strong>Higher incomes ({B.year}):</strong> the Part B and Part D premiums include an extra monthly amount if your income is above{' '}
      {whole(B.irmaaIndividualAbove)} (individual tax return) or {whole(B.irmaaJointAbove)} (joint return).
    </p>
    <p class="costs__change">Medicare amounts change every year. Each figure above is labelled with the year it applies to.</p>
    <p class="costs__sources">
      Sources:{' '}
      {
        sources.map((s, i) => (
          <>
            {i > 0 && ' · '}
            <a class="text-link" href={s.url} target="_blank" rel="noopener">
              {s.label}
              <span class="visually-hidden"> (opens in a new tab)</span>
            </a>
          </>
        ))
      }
    </p>
  </div>
</div>

<style>
  .costs {
    display: grid;
    gap: var(--space-xl);
  }
  .costs__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-s);
  }
  .tile {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.35rem;
    padding: var(--space-l) var(--space-m) var(--space-m);
    background: var(--bg-raised);
    border: 1px solid var(--rule);
  }
  .tile::before {
    content: '';
    position: absolute;
    inset: 5px;
    border: 1px solid rgb(175 130 67 / 0.14);
    pointer-events: none;
  }
  .tile__year {
    position: absolute;
    inset-block-start: 0.7rem;
    inset-inline-end: 0.8rem;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--accent);
  }
  .tile__label {
    padding-inline-end: 3rem;
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .tile__value {
    font-family: var(--ff-display);
    font-size: clamp(2.5rem, 2rem + 1.6vw, 3.5rem);
    font-weight: 500;
    line-height: 1.05;
    color: var(--heading);
  }
  .tile__unit {
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
  .costs__notes {
    display: grid;
    gap: var(--space-s);
    max-width: 60rem;
  }
  .costs__change {
    font-weight: 500;
    color: var(--accent);
  }
  .costs__sources {
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
</style>
