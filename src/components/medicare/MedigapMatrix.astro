---
/**
 * Medigap (Medicare Supplement) standardized plan benefits — Plans A, B, C*,
 * D, F*, G, K, L, M, N. An accessible table (caption, row and column headers,
 * text for every symbol) that scrolls sideways inside its own frame on small
 * screens, with the benefit names pinned on the left.
 * "Show plans" buttons let visitors hide columns to compare just a few plans
 * (src/scripts/medicare/medigap.ts). Data: MEDIGAP_* in src/data/medicare.ts.
 */
import Icon from '../ui/Icon.astro';
import { FIGURES, MEDIGAP_BENEFITS, MEDIGAP_NJ_NOTE, MEDIGAP_NOTES, MEDIGAP_OOP, MEDIGAP_PLANS, MEDIGAP_PRE2020, SOURCES, type MedigapCoverage } from '../../data/medicare';

const isPre2020 = (p: string) => (MEDIGAP_PRE2020 as string[]).includes(p);
const describe = (c: MedigapCoverage) =>
  c === 100 ? 'Pays 100%' : c === 0 ? 'Not covered' : c === 'N' ? 'Pays 100%, except Plan N copays (see notes)' : `Pays ${c}%`;
---

<div class="medigap" data-medigap>
  <div class="medigap__filter" role="group" aria-labelledby="medigap-filter-label">
    <p class="medigap__filter-label" id="medigap-filter-label">Show plans</p>
    <div class="medigap__chips">
      {
        MEDIGAP_PLANS.map((p) => (
          <button type="button" class="chip" aria-pressed="true" data-plan-toggle={p}>
            <span class="chip__box" aria-hidden="true">
              <Icon name="check" />
            </span>
            Plan {p}
            {isPre2020(p) ? '*' : ''}
          </button>
        ))
      }
      <button type="button" class="chip chip--all" data-plan-all>Show all</button>
    </div>
    <p class="visually-hidden" aria-live="polite" data-medigap-status></p>
  </div>

  <div class="medigap__scroll" role="region" aria-labelledby="medigap-caption" tabindex="0" data-lenis-prevent>
    <table class="medigap__table">
      <caption id="medigap-caption" class="medigap__caption">
        What each Medigap plan pays — * Plans C and F are only for people eligible for Medicare before 2020
      </caption>
      <thead>
        <tr>
          <th scope="col" class="medigap__benefit-head">Benefit</th>
          {
            MEDIGAP_PLANS.map((p) => (
              <th scope="col" class="medigap__plan-head" data-col={p}>
                <span class="medigap__plan-word">Plan</span>
                <span class="medigap__plan-letter">
                  {p}
                  {isPre2020(p) && <sup>*</sup>}
                </span>
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          MEDIGAP_BENEFITS.map((b) => (
            <tr>
              <th scope="row" class="medigap__benefit">
                {b.benefit}
                {b.detail && <span class="medigap__detail">{b.detail}</span>}
              </th>
              {MEDIGAP_PLANS.map((p) => {
                const c = b.coverage[p];
                return (
                  <td data-col={p} class:list={['medigap__cell', { 'is-full': c === 100 || c === 'N', 'is-none': c === 0, 'is-part': typeof c === 'number' && c > 0 && c < 100 }]}>
                    {c === 100 || c === 'N' ? (
                      <>
                        <Icon name="check-circle" size={26} class="medigap__yes" />
                        {c === 'N' && (
                          <span class="medigap__mark" aria-hidden="true">
                            †
                          </span>
                        )}
                      </>
                    ) : c === 0 ? (
                      <span class="medigap__dash" aria-hidden="true">
                        —
                      </span>
                    ) : (
                      <span class="medigap__pct" aria-hidden="true">
                        {c}%
                      </span>
                    )}
                    <span class="visually-hidden">{describe(c)}</span>
                  </td>
                );
              })}
            </tr>
          ))
        }
        <tr class="medigap__oop-row">
          <th scope="row" class="medigap__benefit">
            Yearly out-of-pocket limit
            <span class="medigap__detail">{FIGURES.medigap.year} amounts</span>
          </th>
          {
            MEDIGAP_PLANS.map((p) => (
              <td data-col={p} class="medigap__cell">
                {MEDIGAP_OOP[p] ? (
                  <span class="medigap__oop">{MEDIGAP_OOP[p]}</span>
                ) : (
                  <>
                    <span class="medigap__dash" aria-hidden="true">
                      —
                    </span>
                    <span class="visually-hidden">No limit needed or none</span>
                  </>
                )}
              </td>
            ))
          }
        </tr>
      </tbody>
    </table>
  </div>
  <p class="medigap__hint" aria-hidden="true">
    <Icon name="arrows-clockwise" /> Swipe the table sideways to see every plan.
  </p>

  <ul class="medigap__notes" role="list">
    {MEDIGAP_NOTES.map((n) => <li>{n}</li>)}
  </ul>

  <p class="medigap__nj">
    <strong>New Jersey note:</strong>
    {MEDIGAP_NJ_NOTE}
  </p>

  <p class="medigap__source">
    Sources:{' '}
    <a class="text-link" href={SOURCES.medigapCompare.url} target="_blank" rel="noopener">
      {SOURCES.medigapCompare.label}<span class="visually-hidden"> (opens in a new tab)</span>
    </a>
    {' · '}
    <a class="text-link" href={SOURCES.njShipMedigap.url} target="_blank" rel="noopener">
      {SOURCES.njShipMedigap.label}<span class="visually-hidden"> (opens in a new tab)</span>
    </a>
    {' · '}
    <a class="text-link" href={SOURCES.medigapKL2027.url} target="_blank" rel="noopener">
      {SOURCES.medigapKL2027.label}<span class="visually-hidden"> (opens in a new tab)</span>
    </a>
    {' · '}
    <a class="text-link" href={SOURCES.medigapHD2027.url} target="_blank" rel="noopener">
      {SOURCES.medigapHD2027.label}<span class="visually-hidden"> (opens in a new tab)</span>
    </a>
  </p>
</div>

<script>
  import '../../scripts/medicare/medigap';
</script>

<style>
  .medigap {
    display: grid;
    gap: var(--space-m);
  }

  /* ── "Show plans" toggles ── */
  .medigap__filter {
    display: grid;
    gap: var(--space-xs);
  }
  :global(html.no-js) .medigap__filter {
    display: none;
  }
  .medigap__filter-label {
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent);
  }
  .medigap__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-block-size: 2.75rem;
    padding: 0 0.9rem 0 0.7rem;
    border-radius: var(--radius-s);
    font-size: 1rem;
    font-weight: 500;
    color: var(--text);
    box-shadow: inset 0 0 0 1px var(--rule);
    transition:
      background-color var(--dur-hover) var(--ease-out),
      box-shadow var(--dur-hover) var(--ease-out);
  }
  .chip:hover {
    box-shadow: inset 0 0 0 1px var(--rule-strong);
  }
  .chip__box {
    display: grid;
    place-items: center;
    inline-size: 1.15rem;
    block-size: 1.15rem;
    border-radius: 2px;
    box-shadow: inset 0 0 0 1px var(--rule-strong);
    font-size: 0.85rem;
  }
  .chip__box :global(.icon) {
    opacity: 0;
  }
  .chip[aria-pressed='true'] {
    background: rgb(175 130 67 / 0.14);
    box-shadow: inset 0 0 0 1px var(--rule-strong);
  }
  .chip[aria-pressed='true'] .chip__box {
    background: var(--gold-400);
    color: var(--green-900);
    box-shadow: none;
  }
  .chip[aria-pressed='true'] .chip__box :global(.icon) {
    opacity: 1;
  }
  .chip--all {
    padding-inline: 0.9rem;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-color: var(--rule-strong);
    box-shadow: none;
  }

  /* ── The table, in its own sideways-scrolling frame ── */
  .medigap__scroll {
    overflow-x: auto;
    border: 1px solid var(--rule);
    background: var(--bg-raised);
    box-shadow: var(--shadow-m);
    overscroll-behavior-x: contain;
  }
  .medigap__table {
    inline-size: 100%;
    min-inline-size: 46rem;
    border-collapse: separate;
    border-spacing: 0;
  }
  .medigap__caption {
    caption-side: top;
    padding: var(--space-s) var(--space-m);
    text-align: start;
    font-size: var(--fs-small);
    color: var(--text-muted);
    background: var(--bg-raised);
    border-block-end: 1px solid var(--rule);
  }
  .medigap__table th,
  .medigap__table td {
    padding: var(--space-xs) var(--space-2xs);
    border-block-end: 1px solid var(--rule);
    text-align: center;
    vertical-align: middle;
  }
  .medigap__table thead th {
    background: var(--green-900);
    color: var(--ivory-100);
    border-block-end: 1px solid var(--gold-600);
  }
  .medigap__benefit-head,
  .medigap__benefit {
    position: sticky;
    inset-inline-start: 0;
    z-index: 1;
    inline-size: 15rem;
    min-inline-size: 13rem;
    text-align: start !important;
    padding-inline: var(--space-s) !important;
    box-shadow: 1px 0 0 var(--rule);
  }
  .medigap__benefit-head {
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--gold-400) !important;
  }
  .medigap__benefit {
    background: var(--bg-raised);
    font-weight: 500;
    line-height: 1.35;
    color: var(--heading);
  }
  .medigap__detail {
    display: block;
    margin-block-start: 0.15rem;
    font-size: var(--fs-small);
    font-weight: 400;
    color: var(--text-muted);
  }
  .medigap__plan-head {
    min-inline-size: 3.6rem;
  }
  .medigap__plan-word {
    display: block;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold-400);
  }
  .medigap__plan-letter {
    display: block;
    font-family: var(--ff-display);
    font-size: 1.75rem;
    font-weight: 600;
    line-height: 1.1;
  }
  .medigap__plan-letter sup {
    font-size: 0.6em;
    color: var(--gold-400);
  }
  .medigap__table tbody tr:hover td,
  .medigap__table tbody tr:hover th {
    background-color: rgb(175 130 67 / 0.09);
  }
  .medigap__table tbody tr:hover th {
    background-color: color-mix(in srgb, var(--bg-raised) 91%, var(--gold-600));
  }
  .medigap__cell {
    position: relative;
    color: var(--text);
  }
  .medigap__cell :global(.medigap__yes) {
    margin-inline: auto;
    color: var(--accent);
  }
  .medigap__dash {
    color: var(--text-muted);
  }
  .medigap__pct,
  .medigap__oop {
    font-weight: 600;
    color: var(--accent);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .medigap__oop {
    font-size: 0.9375rem;
  }
  .medigap__mark {
    font-weight: 600;
    color: var(--accent);
  }
  .medigap__cell .medigap__mark {
    position: absolute;
    inset-block-start: 0.35rem;
    inset-inline-end: 0.45rem;
  }
  .medigap__oop-row th,
  .medigap__oop-row td {
    border-block-end: 0;
  }

  .medigap__hint {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
  @media (min-width: 80rem) {
    .medigap__hint {
      display: none;
    }
  }

  .medigap__notes {
    display: grid;
    gap: var(--space-xs);
    color: var(--text-muted);
    max-width: 60rem;
  }
  .medigap__notes li {
    position: relative;
    padding-inline-start: var(--space-m);
  }
  .medigap__notes li::before {
    content: '◆';
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.15em;
    font-size: 0.6em;
    color: var(--accent);
  }
  .medigap__nj {
    max-width: 60rem;
    padding: var(--space-s) var(--space-m);
    border-inline-start: 2px solid var(--rule-strong);
    background: rgb(175 130 67 / 0.08);
  }
  .medigap__source {
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
</style>
