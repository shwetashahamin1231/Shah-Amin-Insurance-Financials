---
/**
 * Presents an event poster like a framed print: ivory mat, thin gold border,
 * soft shadow. The poster itself is never cropped or altered (contain).
 * mode 'lightbox' opens it full size; mode 'link' goes to the event page.
 */
import { Picture } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import type { EventPoster } from '../../data/events';
import { url } from '../../lib/url';

interface Props {
  poster: EventPoster;
  title: string;
  mode?: 'lightbox' | 'link' | 'static';
  href?: string;
  /** Lightbox dialog id (mode 'lightbox'). */
  lightboxId?: string;
  sizes?: string;
  priority?: boolean;
  class?: string;
}
const { poster, title, mode = 'static', href, lightboxId, sizes = '(min-width: 64rem) 34vw, 86vw', priority = false, class: className } = Astro.props;
const Tag = mode === 'link' ? 'a' : mode === 'lightbox' ? 'button' : 'div';
---

<figure class:list={['poster-frame', className]}>
  <Tag
    class="poster-frame__mat"
    href={mode === 'link' && href ? url(href) : undefined}
    type={mode === 'lightbox' ? 'button' : undefined}
    data-dialog-open={mode === 'lightbox' ? lightboxId : undefined}
    aria-label={mode === 'lightbox' ? `View the full-size poster for ${title}` : mode === 'link' ? `${title} — event details` : undefined}
    data-cursor={mode !== 'static' ? 'view' : undefined}
  >
    <Picture
      src={poster.image}
      alt={poster.alt}
      widths={[320, 480, 640, 800, poster.image.width]}
      sizes={sizes}
      formats={['avif', 'webp']}
      class="poster-frame__img"
      priority={priority}
    />
    {
      mode !== 'static' && (
        <span class="poster-frame__hint" aria-hidden="true">
          <Icon name={mode === 'lightbox' ? 'zoom' : 'arrow-up-right'} /> {mode === 'lightbox' ? 'View full size' : 'Event details'}
        </span>
      )
    }
  </Tag>
</figure>

<style>
  .poster-frame {
    margin: 0;
  }
  .poster-frame__mat {
    position: relative;
    display: block;
    inline-size: 100%;
    padding: clamp(0.75rem, 0.5rem + 1vw, 1.25rem);
    background: var(--ivory-50);
    border: 1px solid rgb(175 130 67 / 0.75);
    outline: 1px solid rgb(175 130 67 / 0.4);
    outline-offset: -7px;
    box-shadow: var(--shadow-poster);
    color: inherit;
    text-decoration: none;
    cursor: pointer;
    transition:
      transform 600ms var(--ease-silk),
      box-shadow 600ms var(--ease-silk);
  }
  div.poster-frame__mat {
    cursor: default;
  }
  a.poster-frame__mat:hover,
  button.poster-frame__mat:hover {
    transform: translateY(calc(-6px * var(--motion)));
    box-shadow: 0 6px 12px rgb(6 18 6 / 0.2), 0 40px 80px -26px rgb(6 18 6 / 0.65);
  }
  .poster-frame__mat :global(picture),
  .poster-frame__mat :global(img) {
    display: block;
    inline-size: 100%;
    block-size: auto;
    object-fit: contain;
  }
  .poster-frame__hint {
    position: absolute;
    inset-block-end: 1.6rem;
    inset-inline-end: 1.6rem;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.85rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ivory-100);
    background: rgb(14 36 15 / 0.88);
    border: 1px solid rgb(221 181 121 / 0.6);
    opacity: 0;
    transform: translateY(calc(6px * var(--motion)));
    transition: opacity var(--dur-ui) var(--ease-out), transform var(--dur-ui) var(--ease-out);
  }
  .poster-frame__mat:hover .poster-frame__hint,
  .poster-frame__mat:focus-visible .poster-frame__hint {
    opacity: 1;
    transform: none;
  }
  @media (hover: none) {
    .poster-frame__hint {
      opacity: 1;
      transform: none;
    }
  }
</style>
