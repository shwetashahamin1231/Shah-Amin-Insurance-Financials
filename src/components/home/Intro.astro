---
/**
 * Signature intro curtain (home page, first page of a visit only).
 * Shown from the very first frame when the inline head script adds
 * `html.intro-play`; never shown without JavaScript or with reduced motion.
 * scripts/motion/intro.ts draws the gold line art (traced from the real logo)
 * at centre stage, fades in a copy of the logo beneath it, lets the peacock
 * mascot nuzzle it, then rolls it onto the real logo as the curtain lifts.
 */
import lineartUrl from '../../assets/brand/logo-lineart.svg?url';
---

<div class="intro" data-intro>
  <div class="intro__curtain" data-intro-curtain aria-hidden="true">
    <div class="intro__guilloche"></div>
  </div>
  <!-- A copy of the logo that rolls into place (its src is set by the intro script). -->
  <img class="intro__logo" data-intro-logo alt="" aria-hidden="true" decoding="async" />
  <!-- Gold line art traced from the logo; fetched and drawn by scripts/motion/intro.ts. -->
  <svg class="intro__lineart" viewBox="0 0 720 720" data-intro-lineart data-src={lineartUrl} aria-hidden="true" focusable="false"></svg>
  <button type="button" class="intro__skip" data-intro-skip>Skip intro</button>
</div>

<script is:inline>
  // Keep keyboard focus out of the page while the curtain is up.
  if (document.documentElement.classList.contains('intro-play')) {
    document.querySelectorAll('[data-intro-inert]').forEach(function (el) {
      el.inert = true;
    });
  }
</script>

<style>
  .intro {
    display: none;
  }
  :global(html.intro-play:not(.intro-done)) .intro {
    display: block;
  }
  .intro__curtain {
    position: fixed;
    inset: 0;
    z-index: var(--z-intro);
    background:
      radial-gradient(70% 60% at 50% 45%, var(--green-800), var(--green-900) 70%, var(--green-950));
  }
  .intro__guilloche {
    position: absolute;
    inset: 0;
    background: var(--gold-500);
    opacity: 0.06;
    -webkit-mask: url('../../assets/patterns/guilloche-tile.svg') 0 0 / 240px repeat;
    mask: url('../../assets/patterns/guilloche-tile.svg') 0 0 / 240px repeat;
  }
  /* Layers: curtain · peacock (+2) · logo and line art (+3) · sparkles (+4) · skip (+5).
     The logo sits in front of the bird, which stands just behind the coin's rim. */
  .intro__lineart {
    /* A 720px box at the top-left corner; the intro script moves and scales it
       over the centre-stage logo with transforms, then makes it visible. */
    position: fixed;
    inset: 0 auto auto 0;
    inline-size: 720px;
    block-size: 720px;
    transform-origin: 0 0;
    z-index: calc(var(--z-intro) + 3);
    overflow: visible;
    pointer-events: none;
    visibility: hidden;
  }
  .intro__lineart :global(path) {
    fill: none;
    stroke: var(--gold-400);
    stroke-width: 2; /* in the 720px box — renders ≈1px at hero size after scaling */
    stroke-linejoin: round;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  /* The rolling logo: placed, scaled and rotated by the intro script with transforms. */
  .intro__logo {
    position: fixed;
    inset: 0 auto auto 0;
    z-index: calc(var(--z-intro) + 3);
    max-inline-size: none;
    border-radius: 50%;
    box-shadow:
      0 0 0 1px rgb(175 130 67 / 0.7),
      0 24px 60px -18px rgb(0 0 0 / 0.75);
    pointer-events: none;
    visibility: hidden;
    will-change: transform;
  }
  /* Gold sparkles where the peacock's beak meets the logo (created by the script). */
  .intro :global(.intro__spark) {
    position: fixed;
    inset: 0 auto auto 0;
    z-index: calc(var(--z-intro) + 4);
    translate: -50% -50%;
    pointer-events: none;
    opacity: 0;
  }
  .intro :global(.intro__spark svg) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    fill: var(--gold-300);
  }
  /* The peacock mascot steps onto the stage, above the curtain, while the intro runs. */
  :global(html.intro-running [data-peacock-root]) {
    z-index: calc(var(--z-intro) + 2);
  }
  .intro__skip {
    position: fixed;
    inset-block-end: max(1.5rem, env(safe-area-inset-bottom));
    inset-inline-end: max(1.5rem, env(safe-area-inset-right));
    z-index: calc(var(--z-intro) + 5);
    min-block-size: 44px;
    padding: 0.6rem 1.1rem;
    color: var(--ivory-100);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    border-radius: var(--radius-s);
    box-shadow: inset 0 0 0 1px rgb(175 130 67 / 0.55);
    background: rgb(6 18 6 / 0.35);
    opacity: 0;
    animation: intro-skip-in 0.5s var(--ease-out) 0.4s forwards;
  }
  .intro__skip:hover {
    color: var(--gold-300);
  }
  @keyframes intro-skip-in {
    to {
      opacity: 1;
    }
  }
</style>
