---
/**
 * Gallery — photos listed in src/data/gallery.ts (files in src/assets/gallery/).
 * Until photos are added, elegant engraved placeholders hold the layout.
 */
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import Lightbox, { type LightboxImage } from '../components/ui/Lightbox.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import { galleryPhotos } from '../lib/gallery';

const photos = galleryPhotos();
const lightboxImages: LightboxImage[] = photos.map((p) => ({ src: p.src, alt: p.alt, caption: p.caption }));

// Editorial rows on wide screens: two large photos, then rows of three; the last
// row widens its photos so it is always full (a pair → halves, one → full width).
type Span = 'half' | 'third' | 'full';
function spanFor(i: number, n: number): Span {
  if (n === 1) return 'full';
  if (i < 2) return 'half';
  const rest = (n - 2) % 3;
  if (rest === 2 && i >= n - 2) return 'half';
  if (rest === 1 && i === n - 1) return 'full';
  return 'third';
}
const SIZES: Record<Span, string> = {
  half: '(min-width: 40rem) 46vw, 92vw',
  third: '(min-width: 64rem) 30vw, (min-width: 40rem) 46vw, 92vw',
  full: '(min-width: 40rem) 92vw, 92vw',
};

// Placeholder tiles while the gallery is empty.
const placeholders = Array.from({ length: 8 }, (_, i) => spanFor(i, 8));
---

<BaseLayout title="Gallery" description="Photos from Shah & Amin Financial Services seminars, member events and community gatherings.">
  <PageHero eyebrow="Gallery" title="Moments from <em>our events</em>" lead="Seminars, member events and celebrations with the families we serve. Thank you for being part of our story." />

  <section class="section surface-paper" aria-label="Photos">
    <div class="container">
      {
        photos.length ? (
          <ul class="photo-grid" role="list">
            {photos.map((p, i) => (
              <li class={`photo-grid__item photo-grid__item--${spanFor(i, photos.length)}`} data-reveal>
                <button type="button" class="tile" data-dialog-open="gallery-lightbox" data-lightbox-start={i} data-cursor="view" aria-label={`Open photo: ${p.alt}`}>
                  <Picture src={p.src} alt={p.alt} widths={[360, 540, 720, 960, 1280]} sizes={i === 0 ? '(min-width: 64rem) 46vw, 92vw' : SIZES[spanFor(i, photos.length)]} formats={['avif', 'webp']} fallbackFormat="jpg" class="tile__img" />
                  {p.caption && <span class="tile__caption">{p.caption}</span>}
                </button>
              </li>
            ))}
          </ul>
        ) : (
          <>
            <ul class="photo-grid" role="list" aria-label="Photos coming soon">
              {placeholders.map((span) => (
                <li class={`photo-grid__item photo-grid__item--${span}`} data-reveal>
                  <div class="tile tile--placeholder" aria-hidden="true">
                    <span class="tile__mark">
                      <Icon name="leaf" size={28} />
                    </span>
                    <span class="tile__soon">Photo coming soon</span>
                  </div>
                </li>
              ))}
            </ul>
            <div class="soon">
              <p>Photos from our recent events are on their way. In the meantime, join us at an upcoming event.</p>
              <Button href="/events/" variant="outline" icon="arrow-right">
                See upcoming events
              </Button>
            </div>
          </>
        )
      }
    </div>
  </section>

  {photos.length > 0 && <Lightbox slot="overlay" id="gallery-lightbox" label="Gallery photos" images={lightboxImages} />}
</BaseLayout>

<style>
  .photo-grid {
    display: grid;
    gap: var(--space-m);
  }
  /* Two columns: with an odd number of photos, the first one leads at full width. */
  @media (min-width: 40rem) and (max-width: 63.99rem) {
    .photo-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .photo-grid__item:first-child:nth-last-child(odd) {
      grid-column: 1 / -1;
    }
  }
  /* Six-track grid: halves span 3, thirds span 2, full spans 6 (see spanFor). */
  @media (min-width: 64rem) {
    .photo-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: var(--space-l);
    }
    .photo-grid__item--third {
      grid-column: span 2;
    }
    .photo-grid__item--half {
      grid-column: span 3;
    }
    .photo-grid__item--full {
      grid-column: 1 / -1;
    }
  }
  .tile {
    position: relative;
    display: block;
    inline-size: 100%;
    padding: 0.6rem;
    background: var(--ivory-50);
    border: 1px solid rgb(141 97 39 / 0.45);
    box-shadow: var(--shadow-s);
    overflow: hidden;
    cursor: pointer;
    transition:
      transform var(--dur-ui) var(--ease-out),
      box-shadow var(--dur-ui) var(--ease-out);
  }
  button.tile:hover {
    transform: translateY(calc(-4px * var(--motion)));
    box-shadow: var(--shadow-m);
  }
  /* Every photo shows at 3:2 so rows line up; portrait shots are cropped toward the top. */
  .tile :global(img) {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    object-position: 50% 30%;
  }
  .photo-grid__item--full .tile :global(img) {
    aspect-ratio: 21 / 9;
  }
  .tile__caption {
    display: block;
    padding: 0.7rem 0.25rem 0.2rem;
    font-size: var(--fs-small);
    color: var(--ink-muted);
    text-align: start;
  }
  .tile--placeholder {
    aspect-ratio: 3 / 2;
    display: grid;
    place-items: center;
    align-content: center;
    gap: var(--space-s);
    cursor: default;
    background:
      radial-gradient(80% 70% at 50% 40%, rgb(80 113 75 / 0.35), transparent 70%),
      var(--green-900);
    border-color: var(--gold-600);
    outline: 1px solid rgb(175 130 67 / 0.35);
    outline-offset: -9px;
    isolation: isolate;
  }
  .tile--placeholder::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--gold-500);
    opacity: 0.1;
    -webkit-mask: url('../assets/patterns/guilloche-tile.svg') 0 0 / 200px repeat;
    mask: url('../assets/patterns/guilloche-tile.svg') 0 0 / 200px repeat;
  }
  .tile__mark {
    display: grid;
    place-items: center;
    inline-size: 56px;
    block-size: 56px;
    border-radius: 50%;
    color: var(--gold-400);
    box-shadow: inset 0 0 0 1px rgb(221 181 121 / 0.6);
  }
  .tile__soon {
    font-family: var(--ff-display);
    font-size: 1.375rem;
    font-style: italic;
    color: var(--ivory-muted);
    text-align: center;
    padding-inline: var(--space-s);
  }
  .soon {
    display: grid;
    justify-items: center;
    gap: var(--space-m);
    margin-block-start: var(--space-xl);
    text-align: center;
    color: var(--text-muted);
    font-size: var(--fs-lead);
  }
</style>
