---
/**
 * Gallery — photos listed in src/data/gallery.ts (files in src/assets/gallery/).
 * Until photos are added, elegant engraved placeholders hold the layout.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import Lightbox, { type LightboxImage } from '../components/ui/Lightbox.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import { GALLERY } from '../data/gallery';
import { getEvent } from '../data/events';

// Every image in the gallery folder, keyed by file name.
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/gallery/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG}', { eager: true });
const byName = new Map(Object.entries(files).map(([path, mod]) => [path.split('/').pop() as string, mod.default]));

const photos = GALLERY.flatMap((item) => {
  const src = byName.get(item.file);
  if (!src) {
    console.warn(`[gallery] "${item.file}" is listed in src/data/gallery.ts but was not found in src/assets/gallery/`);
    return [];
  }
  const event = item.event ? getEvent(item.event) : undefined;
  return [{ ...item, src, caption: item.caption ?? event?.title }];
});
const lightboxImages: LightboxImage[] = photos.map((p) => ({ src: p.src, alt: p.alt, caption: p.caption }));

// Placeholder tiles (varied proportions for an editorial rhythm).
const placeholders = ['4/5', '1/1', '3/4', '4/3', '1/1', '4/5', '3/2', '3/4'];
---

<BaseLayout title="Gallery" description="Photos from Shah & Amin Financial Services member breakfasts, seminars and community events in New Jersey.">
  <PageHero eyebrow="Gallery" title="Moments from <em>our events</em>" lead="Breakfasts, seminars and celebrations with the families we serve. Thank you for being part of our story." />

  <section class="section surface-paper" aria-label="Photos">
    <div class="container">
      {
        photos.length ? (
          <ul class="masonry" role="list">
            {photos.map((p, i) => (
              <li class="masonry__item" data-reveal>
                <button type="button" class="tile" data-dialog-open="gallery-lightbox" data-lightbox-start={i} data-cursor="view" aria-label={`Open photo: ${p.alt}`}>
                  <Picture src={p.src} alt={p.alt} widths={[360, 540, 720, 960]} sizes="(min-width: 64rem) 30vw, (min-width: 40rem) 45vw, 92vw" formats={['avif', 'webp']} class="tile__img" />
                  {p.caption && <span class="tile__caption">{p.caption}</span>}
                </button>
              </li>
            ))}
          </ul>
        ) : (
          <>
            <ul class="masonry" role="list" aria-label="Photos coming soon">
              {placeholders.map((ratio) => (
                <li class="masonry__item" data-reveal>
                  <div class="tile tile--placeholder" style={`aspect-ratio:${ratio}`} aria-hidden="true">
                    <span class="tile__mark">
                      <Icon name="leaf" size={28} />
                    </span>
                    <span class="tile__soon">Photo coming soon</span>
                  </div>
                </li>
              ))}
            </ul>
            <div class="soon">
              <p>Photos from our recent events are on their way. In the meantime, join us at an upcoming event.</p>
              <Button href="/events/" variant="outline" icon="arrow-right">
                See upcoming events
              </Button>
            </div>
          </>
        )
      }
    </div>
  </section>

  {photos.length > 0 && <Lightbox slot="overlay" id="gallery-lightbox" label="Gallery photos" images={lightboxImages} />}
</BaseLayout>

<style>
  .masonry {
    columns: 1;
    column-gap: var(--space-m);
  }
  @media (min-width: 40rem) {
    .masonry {
      columns: 2;
    }
  }
  @media (min-width: 64rem) {
    .masonry {
      columns: 3;
      column-gap: var(--space-l);
    }
  }
  .masonry__item {
    break-inside: avoid;
    margin-block-end: var(--space-m);
  }
  @media (min-width: 64rem) {
    .masonry__item {
      margin-block-end: var(--space-l);
    }
  }
  .tile {
    position: relative;
    display: block;
    inline-size: 100%;
    padding: 0.6rem;
    background: var(--ivory-50);
    border: 1px solid rgb(141 97 39 / 0.45);
    box-shadow: var(--shadow-s);
    overflow: hidden;
    cursor: pointer;
    transition:
      transform var(--dur-ui) var(--ease-out),
      box-shadow var(--dur-ui) var(--ease-out);
  }
  button.tile:hover {
    transform: translateY(calc(-4px * var(--motion)));
    box-shadow: var(--shadow-m);
  }
  .tile :global(img) {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }
  .tile__caption {
    display: block;
    padding: 0.7rem 0.25rem 0.2rem;
    font-size: var(--fs-small);
    color: var(--ink-muted);
    text-align: start;
  }
  .tile--placeholder {
    display: grid;
    place-items: center;
    align-content: center;
    gap: var(--space-s);
    cursor: default;
    background:
      radial-gradient(80% 70% at 50% 40%, rgb(80 113 75 / 0.35), transparent 70%),
      var(--green-900);
    border-color: var(--gold-600);
    outline: 1px solid rgb(175 130 67 / 0.35);
    outline-offset: -9px;
    isolation: isolate;
  }
  .tile--placeholder::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--gold-500);
    opacity: 0.1;
    -webkit-mask: url('../assets/patterns/guilloche-tile.svg') 0 0 / 200px repeat;
    mask: url('../assets/patterns/guilloche-tile.svg') 0 0 / 200px repeat;
  }
  .tile__mark {
    display: grid;
    place-items: center;
    inline-size: 56px;
    block-size: 56px;
    border-radius: 50%;
    color: var(--gold-400);
    box-shadow: inset 0 0 0 1px rgb(221 181 121 / 0.6);
  }
  .tile__soon {
    font-family: var(--ff-display);
    font-size: 1.375rem;
    font-style: italic;
    color: var(--ivory-muted);
    text-align: center;
    padding-inline: var(--space-s);
  }
  .soon {
    display: grid;
    justify-items: center;
    gap: var(--space-m);
    margin-block-start: var(--space-xl);
    text-align: center;
    color: var(--text-muted);
    font-size: var(--fs-lead);
  }
</style>
