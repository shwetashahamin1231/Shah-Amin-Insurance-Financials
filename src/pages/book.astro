---
/**
 * Book an Appointment — the scheduler in a certificate-style frame, with
 * hours, what to expect and tap-to-call cards alongside.
 * Links can preselect choices: /book/?advisor=gautam · /book/?topic=annuities
 * (handled by src/scripts/forms/scheduler.ts).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import Icon from '../components/ui/Icon.astro';
import BookingScheduler from '../components/forms/BookingScheduler.astro';
import AdvisorAvatar from '../components/team/AdvisorAvatar.astro';
import { ADVISOR_LIST, COMPLIANCE, HOURS } from '../config/site';
import { getNextClosure } from '../lib/holidays';
import { addDays, formatDateNoYear, todayET } from '../lib/time';
import { url } from '../lib/url';
import { APPS_SCRIPT } from '../config/forms';

const title = 'Book an Appointment';
const description =
  'Request an appointment with Gautam Shah or Shweta Shah Amin. Choose a day and time — open 7 days, 11 AM to 7 PM Eastern — and meet in person, by phone or by video.';

// Build-time value; the browser refreshes it (see the script below).
const nextClosure = getNextClosure(addDays(todayET(), 1));

/** True on the live site until the Bookings sheet is connected (the scheduler then shows call buttons instead). */
const offline = import.meta.env.PROD && !APPS_SCRIPT.bookings.trim();

const expectations = [
  {
    numeral: 'I',
    text: offline ? 'Call either advisor and choose a day and time together.' : 'Choose a day and time. It’s a request — we’ll call or email you to confirm it.',
  },
  { numeral: 'II', text: 'Meet in person, by phone or by video — whichever is easiest for you.' },
  { numeral: 'III', text: 'Have your questions ready, plus any policies or statements you’d like us to look at.' },
];
---

<BaseLayout title={title} description={description} footerCta={false}>
  <PageHero
    eyebrow="Book an appointment"
    title="Let’s find a time <em>to talk.</em>"
    lead={
      offline
        ? 'Call Gautam or Shweta and we’ll find a day and time that suits you — in person, by phone or by video.'
        : 'Choose a day and time that suits you. It only takes a couple of minutes, and we’ll call or email to confirm.'
    }
  />

  <section class="section surface-paper book" aria-label="Appointment booking">
    <div class="container book__grid">
      <div class="book__frame surface-ivory">
        <BookingScheduler idPrefix="book" />
      </div>

      <aside class="book__aside" aria-label="Hours and ways to reach us">
        <section class="book__card" aria-labelledby="book-hours-title" data-reveal>
          <h2 class="book__card-title" id="book-hours-title"><Icon name="clock" /> Hours</h2>
          <p class="book__status" data-open-status>
            <span class="book__status-dot" aria-hidden="true"></span>
            <span data-open-label>&nbsp;</span>
          </p>
          <p>{HOURS.summary}.</p>
          <p class="muted">
            {HOURS.holidayNote}.
            <span data-next-closure>{nextClosure && `Next holiday closure: ${formatDateNoYear(nextClosure.date)} (${nextClosure.name}).`}</span>
          </p>
        </section>

        <section class="book__card" aria-labelledby="book-expect-title" data-reveal>
          <h2 class="book__card-title" id="book-expect-title"><Icon name="seal-check" /> What to expect</h2>
          <ol class="expect" role="list">
            {
              expectations.map((e) => (
                <li>
                  <span class="expect__num" aria-hidden="true">
                    {e.numeral}
                  </span>
                  <p>{e.text}</p>
                </li>
              ))
            }
          </ol>
        </section>

        <section class="book__card" aria-labelledby="book-medicare-title" data-reveal>
          <h2 class="book__card-title" id="book-medicare-title"><Icon name="info" /> Medicare appointments</h2>
          <ul class="book__notes" role="list">
            <li>Before we discuss Medicare plans, we confirm with you which types of plans you would like to talk about (a short “Scope of Appointment”).</li>
            <li>As Medicare requires, phone and video conversations about Medicare Advantage and Part D plans are recorded.</li>
            <li>We talk about other products, such as life insurance or annuities, only at a separate appointment you ask for.</li>
          </ul>
          <p class="book__disclaimer">{COMPLIANCE.medicareDisclaimer}</p>
        </section>

        {
          !offline && (
            <>
              <section class="book__card" aria-labelledby="book-call-title" data-reveal>
                <h2 class="book__card-title" id="book-call-title"><Icon name="phone-call" /> Rather talk now?</h2>
                <ul class="call-cards" role="list">
                  {
                    ADVISOR_LIST.map((a) => (
                      <li>
                        <a class="call-card" href={`tel:${a.phoneHref}`} aria-label={`Call ${a.name}, ${a.phone}`}>
                          <AdvisorAvatar advisor={a} size={52} />
                          <span class="call-card__text">
                            <span class="call-card__name">{a.name}</span>
                            <span class="call-card__role">{a.title}</span>
                            <span class="call-card__phone num">{a.phone}</span>
                          </span>
                          <Icon name="phone" class="call-card__icon" />
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </section>

              <p class="book__reassure">
                <Icon name="shield-check" />
                <span>
                  Your details go straight to our team and are used only to arrange your appointment.
                  <a class="text-link" href={url('/privacy/')}>Privacy policy</a>
                </span>
              </p>
            </>
          )
        }
      </aside>
    </div>
  </section>
</BaseLayout>

<script>
  // "Open now" line and next holiday closure, worked out in Eastern Time on the visitor's device.
  import { getOpenStatus } from '../lib/hours';
  import { getNextClosure } from '../lib/holidays';
  import { addDays, formatDateNoYear, todayET } from '../lib/time';

  const status = document.querySelector<HTMLElement>('[data-open-status]');
  const label = status?.querySelector<HTMLElement>('[data-open-label]');
  const next = document.querySelector<HTMLElement>('[data-next-closure]');

  function update() {
    const now = new Date();
    if (status && label) {
      const s = getOpenStatus(now);
      label.textContent = s.detail ? `${s.label}. ${s.detail}.` : s.label;
      status.classList.toggle('is-open', s.open);
      status.classList.add('is-ready');
    }
    if (next) {
      const closure = getNextClosure(addDays(todayET(now), 1));
      next.textContent = closure ? `Next holiday closure: ${formatDateNoYear(closure.date)} (${closure.name}).` : '';
    }
  }

  update();
  window.setInterval(update, 60_000);
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') update();
  });
</script>

<style>
  .book {
    padding-block-start: clamp(2.5rem, 1.5rem + 4vw, 5.5rem);
  }
  .book__grid {
    display: grid;
    gap: var(--space-2xl);
    align-items: start;
  }
  @media (min-width: 75rem) {
    .book__grid {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    }
  }

  /* Certificate-style frame: an outer gold rule, and a finer one just inside it. */
  .book__frame {
    position: relative;
    padding: clamp(0.75rem, -0.35rem + 3.4vw, 2.75rem);
    border: 1px solid var(--rule-strong);
    box-shadow: var(--shadow-m);
  }
  .book__frame::before {
    content: '';
    position: absolute;
    inset: 6px;
    border: 1px solid var(--rule);
    pointer-events: none;
  }

  /* ── Sidebar ── */
  .book__aside {
    display: grid;
    gap: var(--space-l);
  }
  @media (min-width: 48rem) and (max-width: 74.99rem) {
    .book__aside {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .book__reassure {
      grid-column: 1 / -1;
    }
  }
  .book__card {
    padding: var(--space-l);
    background-color: var(--bg-raised);
    border: 1px solid var(--rule);
  }
  .book__card > * + * {
    margin-block-start: var(--space-s);
  }
  .book__card-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--fs-h4);
  }
  .book__card-title :global(.icon) {
    font-size: 1.05em;
    color: var(--accent);
  }

  .book__status {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-weight: 500;
    color: var(--heading);
    visibility: hidden; /* keeps its space until the browser fills it in (no layout shift) */
  }
  .book__status.is-ready {
    visibility: visible;
  }
  :global(html.no-js) .book__status {
    display: none;
  }
  .book__status-dot {
    flex: none;
    inline-size: 0.6rem;
    block-size: 0.6rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1.5px var(--text-muted);
    transform: translateY(-0.05rem);
  }
  .book__status.is-open .book__status-dot {
    background-color: var(--green-500);
    box-shadow: 0 0 0 3px rgb(80 113 75 / 0.25);
  }

  .expect {
    display: grid;
    gap: var(--space-s);
  }
  .expect li {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    align-items: baseline;
    gap: 0.5rem;
  }
  .expect__num {
    font-family: var(--ff-display);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1;
    color: var(--accent-large);
  }

  .call-cards {
    display: grid;
    gap: 0.75rem;
  }
  .call-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-block-size: 4.5rem;
    padding: 0.85rem 1rem;
    color: var(--text);
    text-decoration: none;
    background-color: var(--bg);
    border: 1px solid var(--rule);
    transition:
      border-color var(--dur-hover) var(--ease-out),
      transform var(--dur-hover) var(--ease-out),
      box-shadow var(--dur-hover) var(--ease-out);
  }
  .call-card:hover {
    border-color: var(--rule-strong);
    transform: translateY(calc(-3px * var(--motion)));
    box-shadow: var(--shadow-s);
  }
  .call-card__text {
    display: grid;
    line-height: 1.3;
  }
  .call-card__name {
    font-weight: 600;
    color: var(--heading);
  }
  .call-card__role {
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
  .call-card__phone {
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--accent);
  }
  .call-card :global(.call-card__icon) {
    margin-inline-start: auto;
    font-size: 1.5rem;
    color: var(--heading);
  }

  .book__reassure {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
  .book__reassure :global(.icon) {
    flex: none;
    margin-block-start: 0.15rem;
    font-size: 1.25rem;
    color: var(--accent);
  }
  .book__notes {
    display: grid;
    gap: var(--space-xs);
    padding-inline-start: 1.1em;
    list-style: disc;
  }
  .book__notes li::marker {
    color: var(--accent);
  }
  .book__disclaimer {
    margin-block-start: var(--space-s);
    padding-block-start: var(--space-s);
    border-block-start: 1px solid var(--rule);
    font-size: 1rem;
    color: var(--text-muted);
  }
</style>
