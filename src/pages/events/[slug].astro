---
/**
 * Event detail page — generated for every event in src/data/events.ts.
 * Shows the framed poster (opens full size in a lightbox, downloadable),
 * the details, add-to-calendar links and the RSVP form.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PosterFrame from '../../components/events/PosterFrame.astro';
import Lightbox from '../../components/ui/Lightbox.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
import Ornament from '../../components/ui/Ornament.astro';
import RsvpForm from '../../components/forms/RsvpForm.astro';
import { EVENTS, type EventItem } from '../../data/events';
import { ADVISOR_LIST, SITE } from '../../config/site';
import { dateParts, eventStatus, eventTimes, formatEventDate, formatEventTime, formatVenue, isRsvpOpen, venueMapUrl } from '../../lib/events';
import { url } from '../../lib/url';
import { googleCalendarUrl } from '../../lib/ics';

export function getStaticPaths() {
  return EVENTS.map((event) => ({ params: { slug: event.slug }, props: { event } }));
}

interface Props {
  event: EventItem;
}
const { event } = Astro.props;
const status = eventStatus(event);
const rsvpOpen = isRsvpOpen(event);
const venue = formatVenue(event.venue);
const mapUrl = venueMapUrl(event.venue);
const d = dateParts(event);
const times = eventTimes(event);
const statusLabel = { upcoming: 'Upcoming', today: 'Today', past: 'Past Event' }[status];

const site = Astro.site ?? new URL(SITE.url);
const abs = (p: string) => new URL(url(p), site).toString();

// Calendar entry (.ics download + Google Calendar). Without an end time, assume two hours.
const endForCalendar = event.end ? times.end : times.start + 2 * 60 * 60 * 1000;
const calendar = {
  uid: `${event.slug}@shahandamin.com`,
  title: event.title,
  start: new Date(times.start).toISOString(),
  end: new Date(endForCalendar).toISOString(),
  location: venue ? [venue.name, venue.address].filter(Boolean).join(', ') : undefined,
  description: `${event.summary}\n\nQuestions? ${ADVISOR_LIST.map((a) => `${a.firstName}: ${a.phone}`).join(' · ')}`,
  url: abs(`/events/${event.slug}/`),
};
const gcal = googleCalendarUrl({ ...calendar, start: new Date(calendar.start), end: new Date(calendar.end) });
const schema = [
  {
    '@type': 'Event',
    name: event.title,
    startDate: event.start,
    ...(event.end ? { endDate: event.end } : {}),
    eventStatus: 'https://schema.org/EventScheduled',
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    description: event.summary,
    ...(event.poster ? { image: [abs(event.poster.download)] } : {}),
    ...(event.venue?.street
      ? {
          location: {
            '@type': 'Place',
            name: event.venue.name,
            address: { '@type': 'PostalAddress', streetAddress: event.venue.street, addressLocality: event.venue.city, addressRegion: event.venue.state, postalCode: event.venue.zip, addressCountry: 'US' },
          },
        }
      : {}),
    organizer: { '@id': `${abs('/')}#agency` },
    url: abs(`/events/${event.slug}/`),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: 'Events', item: abs('/events/') },
      { '@type': 'ListItem', position: 3, name: event.title, item: abs(`/events/${event.slug}/`) },
    ],
  },
];
---

<BaseLayout
  title={`${event.title} — ${d.weekday}, ${formatEventDate(event).split(', ').slice(1).join(', ')}`}
  description={event.summary}
  image={event.poster?.download}
  imageAlt={event.poster?.alt}
  schema={schema}
>
  <section class="event-hero surface-depth" data-event-detail data-start={event.start} data-end={event.end ?? ''} data-rsvp-closes={event.rsvpCloses ?? event.start} data-rsvp={event.rsvp ? '1' : '0'}>
    <div class="container event-hero__inner">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol role="list">
          <li><a href={url('/')}>Home</a></li>
          <li><a href={url('/events/')}>Events</a></li>
          <li aria-current="page">{event.title}</li>
        </ol>
      </nav>
      <p class="eyebrow eyebrow--rule" data-event-status>{statusLabel}</p>
      <h1 class="event-hero__title" data-hero-split>{event.title}</h1>
      <ul class="event-hero__facts" role="list" data-reveal>
        <li><Icon name="calendar-blank" /> {formatEventDate(event)}</li>
        <li><Icon name="clock" /> {formatEventTime(event)}</li>
        {venue && <li><Icon name="map-pin" /> {venue.name}{venue.address && `, ${venue.address}`}</li>}
      </ul>
      <div class="event-hero__actions" data-reveal>
        <span data-rsvp-action hidden={!rsvpOpen}><Button href="#rsvp" icon="arrow-right" magnetic>RSVP now</Button></span>
        {!event.timeTBA && <Button variant="outline" icon="calendar-check" iconPosition="start" data-ics={JSON.stringify(calendar)}>Add to calendar</Button>}
        {!event.timeTBA && <Button href={gcal} variant="ghost" icon="arrow-up-right">Google Calendar</Button>}
      </div>
    </div>
  </section>

  <section class="section event-body" aria-label="Event details">
    <div class="container event-body__inner">
      <div class="event-body__poster" data-reveal>
        {
          event.poster ? (
            <>
              <PosterFrame poster={event.poster} title={event.title} mode="lightbox" lightboxId="poster-lightbox" priority sizes="(min-width: 64rem) 36vw, 90vw" />
              <div class="event-body__poster-actions">
                <Button href={event.poster.download} variant="outline" size="s" icon="download" iconPosition="start" download="">
                  Download poster
                </Button>
                <Button href="#" variant="ghost" size="s" icon="zoom" data-dialog-open="poster-lightbox">
                  View full size
                </Button>
              </div>
            </>
          ) : (
            <div class="date-plate" aria-hidden="true">
              <span class="date-plate__weekday">{d.weekday}</span>
              <span class="date-plate__day">{d.day}</span>
              <span class="date-plate__month">
                {d.month} {d.year}
              </span>
              <Ornament width={150} draw={false} />
              <span class="date-plate__note">Poster coming soon</span>
            </div>
          )
        }
      </div>

      <div class="event-body__copy">
        {event.highlight && <p class="event-body__highlight" data-reveal>{event.highlight}</p>}
        <div class="prose event-body__text" data-reveal>
          {event.description.map((p) => <p>{p}</p>)}
        </div>
        {
          event.detailsComingSoon && (
            <p class="note" data-reveal>
              <Icon name="info" /> Final details for this event are on their way. Reserve your place and we will contact you with the specifics.
            </p>
          )
        }
        <dl class="details" data-reveal>
          <div>
            <dt>Date</dt>
            <dd>{formatEventDate(event)}</dd>
          </div>
          <div>
            <dt>Time</dt>
            <dd>{formatEventTime(event)}</dd>
          </div>
          {
            venue && (
              <div>
                <dt>Location</dt>
                <dd>
                  {venue.name}
                  {venue.address && <span class="details__addr">{venue.address}</span>}
                  {mapUrl && (
                    <a class="text-link" href={mapUrl} target="_blank" rel="noopener">
                      Open in Google Maps <Icon name="arrow-square-out" />
                    </a>
                  )}
                </dd>
              </div>
            )
          }
          <div>
            <dt>Questions</dt>
            <dd>
              {ADVISOR_LIST.map((a) => (
                <span class="details__call">
                  <a class="text-link" href={`tel:${a.phoneHref}`}>
                    {a.name} · <span class="num">{a.phone}</span>
                  </a>
                </span>
              ))}
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section id="rsvp" class="section surface-paper rsvp" aria-labelledby="rsvp-title" data-event-detail data-start={event.start} data-end={event.end ?? ''} data-rsvp-closes={event.rsvpCloses ?? event.start} data-rsvp={event.rsvp ? '1' : '0'}>
    <div class="container--narrow rsvp__inner">
      <p class="eyebrow eyebrow--rule" data-reveal>Reserve your place</p>
      <h2 id="rsvp-title" data-split>RSVP for <em>{event.title}</em></h2>
      {
        event.rsvp && (
          <div class="rsvp__form" data-reveal>
            <RsvpForm events={EVENTS} selected={event.slug} idPrefix="rsvp" />
          </div>
        )
      }
      {
        !event.rsvp && (
          <p class="rsvp__lead">
            No RSVP is needed for this event. See all <a class="text-link" href={url('/events/')}>upcoming events</a>.
          </p>
        )
      }
    </div>
  </section>

  {event.poster && <Lightbox slot="overlay" id="poster-lightbox" label={`${event.title} poster`} images={[{ src: event.poster.image, alt: event.poster.alt }]} download={{ href: event.poster.download, label: 'Download', filename: event.poster.download.split('/').pop() }} />}
</BaseLayout>

<script>
  import '../../scripts/event-status';
  import { buildIcs, downloadIcs } from '../../lib/ics';

  // "Add to calendar": build the .ics file in the browser from the button's data.
  document.querySelectorAll<HTMLButtonElement>('[data-ics]').forEach((btn) =>
    btn.addEventListener('click', () => {
      const ev = JSON.parse(btn.dataset.ics ?? '{}');
      downloadIcs(`${ev.uid.split('@')[0]}.ics`, buildIcs({ ...ev, start: new Date(ev.start), end: new Date(ev.end) }));
    }),
  );
</script>

<style>
  .event-hero {
    position: relative;
    padding-block: calc(var(--header-total) + clamp(2rem, 1rem + 4vw, 4.5rem)) clamp(3rem, 2rem + 3vw, 5rem);
    border-block-end: 1px solid var(--rule);
  }
  .event-hero__inner > * + * {
    margin-block-start: var(--space-m);
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.6rem;
    font-size: var(--fs-small);
    color: var(--ivory-muted);
  }
  .crumbs li + li::before {
    content: '/';
    margin-inline-end: 0.6rem;
    color: var(--gold-600);
  }
  .crumbs a {
    color: var(--ivory-100);
    text-decoration: underline;
    text-decoration-color: rgb(175 130 67 / 0.5);
    text-underline-offset: 0.22em;
  }
  .event-hero__title {
    font-size: var(--fs-h1);
    max-width: 18ch;
  }
  .event-hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-l);
    font-size: var(--fs-lead);
    color: var(--ivory-100);
  }
  .event-hero__facts li {
    display: inline-flex;
    gap: 0.55rem;
    align-items: center;
  }
  .event-hero__facts :global(.icon) {
    color: var(--gold-400);
  }
  .event-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
  }

  .event-body__inner {
    display: grid;
    gap: var(--space-3xl);
    align-items: start;
  }
  @media (min-width: 64rem) {
    .event-body__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-4xl);
    }
    .event-body__poster {
      position: sticky;
      inset-block-start: calc(var(--header-h) + 2rem);
    }
  }
  .event-body__poster {
    max-inline-size: 32rem;
    inline-size: 100%;
    justify-self: center;
  }
  .event-body__poster-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-s) var(--space-m);
    margin-block-start: var(--space-l);
  }
  .event-body__copy > * + * {
    margin-block-start: var(--space-l);
  }
  .event-body__highlight {
    font-family: var(--ff-display);
    font-size: var(--fs-h3);
    font-style: italic;
    line-height: 1.25;
    color: var(--accent-large);
  }
  .event-body__text {
    font-size: var(--fs-lead);
    line-height: 1.6;
  }
  .note {
    display: flex;
    gap: 0.6rem;
    padding: var(--space-s) var(--space-m);
    border-inline-start: 2px solid var(--gold-500);
    background: rgb(175 130 67 / 0.08);
    color: var(--ivory-100);
  }
  .note :global(.icon) {
    color: var(--gold-400);
    margin-block-start: 0.25em;
  }
  .details {
    display: grid;
    border-block-start: 1px solid var(--rule);
  }
  .details > div {
    display: grid;
    gap: 0.35rem var(--space-m);
    padding-block: var(--space-m);
    border-block-end: 1px solid var(--rule);
  }
  @media (min-width: 40rem) {
    .details > div {
      grid-template-columns: 9rem 1fr;
    }
  }
  .details dt {
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent);
    padding-block-start: 0.2em;
  }
  .details dd {
    display: grid;
    gap: 0.3rem;
    justify-items: start;
  }
  .details__addr {
    color: var(--text-muted);
  }
  .details__call {
    display: block;
  }

  .date-plate {
    display: grid;
    justify-items: center;
    gap: var(--space-xs);
    padding: var(--space-2xl) var(--space-l);
    background: var(--green-900);
    border: 1px solid var(--gold-600);
    outline: 1px solid rgb(175 130 67 / 0.4);
    outline-offset: -10px;
    text-align: center;
    box-shadow: var(--shadow-l);
  }
  .date-plate__weekday,
  .date-plate__month {
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gold-400);
  }
  .date-plate__day {
    font-family: var(--ff-display);
    font-size: clamp(6rem, 4rem + 8vw, 9rem);
    font-weight: 500;
    line-height: 0.9;
    background-image: var(--foil-on-dark);
    background-size: 220% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .date-plate__note {
    font-family: var(--ff-display);
    font-style: italic;
    font-size: 1.5rem;
    color: var(--ivory-muted);
  }

  .rsvp__inner > * + * {
    margin-block-start: var(--space-m);
  }
  .rsvp__lead {
    font-size: var(--fs-lead);
    color: var(--text-muted);
  }
  .rsvp__form {
    padding: clamp(1.5rem, 1rem + 2vw, 2.75rem);
    background: var(--ivory-50);
    border: 1px solid rgb(141 97 39 / 0.45);
    outline: 1px solid rgb(141 97 39 / 0.25);
    outline-offset: -9px;
    box-shadow: var(--shadow-m);
  }
</style>
