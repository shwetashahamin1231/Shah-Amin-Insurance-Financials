---
/**
 * Home page. Sections live in src/components/home/. The signature intro
 * (Intro.astro) plays only on the first page of a visit.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Intro from '../components/home/Intro.astro';
import Hero from '../components/home/Hero.astro';
import Figures from '../components/home/Figures.astro';
import Story from '../components/home/Story.astro';
import ServicesIndex from '../components/home/ServicesIndex.astro';
import MedicareSpotlight from '../components/home/MedicareSpotlight.astro';
import EventsTeaser from '../components/home/EventsTeaser.astro';
import ReviewsBand from '../components/home/ReviewsBand.astro';
import AdvisorsTeaser from '../components/home/AdvisorsTeaser.astro';
import { SITE } from '../config/site';
---

<BaseLayout
  title={SITE.name}
  description="Family-owned since 2000 and licensed in 10 states: life, health, travel, long-term care and disability insurance, annuities, IRAs, 401(k) rollovers and Medicare plans — in plain English."
  intro
>
  <Hero />
  <Figures />
  <Story />
  <ServicesIndex />
  <MedicareSpotlight />
  <EventsTeaser />
  <ReviewsBand />
  <AdvisorsTeaser />
  <Intro slot="overlay" />
</BaseLayout>
