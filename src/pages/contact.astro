---
/**
 * Contact — both advisors side by side (tap to call / email), then hours with
 * a live "open now" status, where we are licensed and how we meet, and booking.
 * There is no office: meetings are by phone, by video, or in person at a place
 * that suits the client. All details come from src/config/site.ts.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import AdvisorAvatar from '../components/team/AdvisorAvatar.astro';
import { ADVISOR_LIST, HOURS, licensedStatesText } from '../config/site';
---

<BaseLayout
  title="Contact Us"
  description="Call Gautam Shah at (973) 722-9191 or Shweta Shah Amin at (732) 543-9835, email us, or book an appointment. Open 7 days a week, 11 AM – 7 PM Eastern."
>
  <PageHero
    eyebrow="Contact us"
    title="We’d love to <em>hear from you</em>"
    lead="Call or email either advisor directly, or book a time that suits you. We are open seven days a week."
  />

  <section class="section surface-paper" aria-labelledby="advisors-title">
    <div class="container">
      <h2 id="advisors-title" class="visually-hidden">Our advisors</h2>
      <ul class="cards" role="list">
        {
          ADVISOR_LIST.map((a) => (
            <li class="card" data-reveal>
              <div class="card__head">
                <AdvisorAvatar advisor={a} size={76} class="card__monogram" />
                <div>
                  <h3 class="card__name">{a.name}</h3>
                  <p class="card__title">{a.title}</p>
                </div>
              </div>
              <a class="card__phone" href={`tel:${a.phoneHref}`} aria-label={`Call ${a.name} at ${a.phone}`}>
                <Icon name="phone" />
                <span class="num">{a.phone}</span>
              </a>
              <a class="card__email text-link" href={`mailto:${a.email}`}>
                <Icon name="envelope" /> {a.email}
              </a>
              <div class="card__actions">
                <Button href={`tel:${a.phoneHref}`} icon="phone-call" iconPosition="start">
                  Call {a.firstName}
                </Button>
                <Button href={`/book/?advisor=${a.id}`} variant="outline" icon="calendar-check" iconPosition="start">
                  Book with {a.firstName}
                </Button>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section surface-deep office" aria-labelledby="office-title">
    <div class="container">
      <p class="eyebrow eyebrow--rule" data-reveal>Hours &amp; meetings</p>
      <h2 id="office-title" class="office__title" data-split>When and how <em>we meet</em></h2>

      <div class="office__grid">
        <div class="office__block" data-reveal>
          <h3 class="office__label"><Icon name="clock" /> Hours</h3>
          <p class="office__value">
            Monday – Sunday, 11:00 AM – 7:00 PM Eastern<br />
            <span class="muted">{HOURS.holidayNote}</span>
          </p>
          <p class="office__status" data-open-status hidden></p>
        </div>

        <div class="office__block" data-reveal>
          <h3 class="office__label"><Icon name="users-three" /> How we meet</h3>
          <p class="office__value">By phone, by video, or in person at a place that suits you.</p>
        </div>

        <div class="office__block" data-reveal>
          <h3 class="office__label"><Icon name="certificate" /> Licensed in</h3>
          <p class="office__value">{licensedStatesText()}.</p>
        </div>
      </div>

      <div class="office__cta" data-reveal>
        <Button href="/book/" size="l" icon="calendar-check" iconPosition="start" magnetic>Book an Appointment</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import '../scripts/open-status';
</script>


<style>
  .cards {
    display: grid;
    gap: var(--space-l);
  }
  @media (min-width: 56rem) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-xl);
    }
  }
  .card {
    position: relative;
    display: grid;
    gap: var(--space-m);
    align-content: start;
    padding: clamp(1.75rem, 1.25rem + 2vw, 3rem);
    background: var(--ivory-50);
    border: 1px solid rgb(141 97 39 / 0.45);
    outline: 1px solid rgb(141 97 39 / 0.25);
    outline-offset: -10px;
    box-shadow: var(--shadow-m);
  }
  .card__head {
    display: flex;
    align-items: center;
    gap: var(--space-m);
  }
  .card__head :global(.card__monogram) {
    box-shadow: 0 0 0 1px var(--gold-600), 0 0 0 5px var(--ivory-50), 0 0 0 6px rgb(141 97 39 / 0.4);
  }
  .card__name {
    font-size: var(--fs-h3);
  }
  .card__title {
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent);
  }
  .card__phone {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--ff-display);
    font-size: clamp(2.25rem, 1.8rem + 1.8vw, 3rem);
    font-weight: 500;
    line-height: 1.1;
    color: var(--heading);
    text-decoration: none;
    padding-block: var(--space-xs);
    border-block: 1px solid var(--rule);
  }
  .card__phone :global(.icon) {
    font-size: 0.7em;
    color: var(--gold-700);
  }
  .card__phone:hover {
    color: var(--gold-800);
  }
  .card__email {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    justify-self: start;
    min-block-size: 44px;
    overflow-wrap: anywhere;
  }
  .card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
  }

  .office__grid {
    display: grid;
    gap: var(--space-l) var(--space-2xl);
  }
  @media (min-width: 56rem) {
    .office__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .office__cta {
    margin-block-start: var(--space-2xl);
  }
  .office__title {
    margin-block: var(--space-m) var(--space-2xl);
    font-size: var(--fs-h1);
  }
  .office__block {
    padding-block-start: var(--space-m);
    border-block-start: 1px solid var(--rule);
  }
  .office__label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--ff-body);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent);
    margin-block-end: 0.5rem;
  }
  .office__value {
    font-size: var(--fs-lead);
    line-height: 1.55;
  }
  .office__status {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-block-start: var(--space-s);
    padding: 0.4rem 0.85rem;
    font-weight: 500;
    color: var(--gold-300);
    border: 1px solid rgb(221 181 121 / 0.45);
  }
  .office__status::before {
    content: '';
    inline-size: 0.55rem;
    block-size: 0.55rem;
    border-radius: 50%;
    background: currentColor;
  }
  .office__status[data-open='true'] {
    color: #a8dba2;
    border-color: rgb(168 219 162 / 0.45);
  }

</style>
